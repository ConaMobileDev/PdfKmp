<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
          AndroidX App Startup initializer that captures the application
          Context so the renderer (which runs in a coroutine, not a
          Composable) can resolve the cache directory without the caller
          having to wire anything up by hand. The authority must match
          the canonical androidx.startup authority so this contribution
          merges with the provider declaration that the consumer app's
          merged manifest already carries.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.conamobile.pdfkmp.viewer.internal.ViewerContextInitializer"
                android:value="androidx.startup" />
        </provider>

        <!--
          Per-app FileProvider used by the built-in share sheet of the
          PdfViewer composable. The authority is suffixed with the
          consumer app's package name so two apps that both depend on
          `pdfkmp-viewer` cannot collide. The path mapping lives in
          res/xml/pdfkmp_viewer_file_paths.xml.

          IMPORTANT: a dedicated subclass of `FileProvider` is used as
          `android:name` instead of `androidx.core.content.FileProvider`
          so the Android manifest merger does not collapse this entry
          into the host app's own FileProvider declaration (merger uses
          `android:name` as the merge key for `<provider>`). Without
          this, the host's higher-priority manifest would win and the
          library's authority + path meta-data would silently disappear
          from the merged manifest, breaking the share sheet at runtime.
        -->
        <provider
            android:name="com.conamobile.pdfkmp.viewer.internal.PdfKmpViewerFileProvider"
            android:authorities="${applicationId}.pdfkmp.viewer.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pdfkmp_viewer_file_paths" />
        </provider>

        <!--
          Hosted full-screen Activity that backs `KmpPdfLauncher.open(...)`.
          Inherits the consumer app's theme via `@android:style/Theme.Material.NoActionBar`
          so the system status bar still renders the host's accent and
          status-bar icon colour scheme. `exported="false"` so external
          apps can't bind to the activity directly — entry is through
          `KmpPdfLauncher` only.
        -->
        <activity
            android:name="com.conamobile.pdfkmp.viewer.KmpPdfViewerHostActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|locale|layoutDirection|smallestScreenSize|screenLayout|uiMode"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
